---
import { content, langOf, localize } from '../content/i18n';

const lang = langOf(Astro.url);
const L = (path: string): string => localize(path, lang);
const { projectPages, ui } = content(lang);
---
<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container">
    <h2 id="projects-title" class="section-title">{ui.projects.heading}</h2>
    <ol class="project-list wide">
      {
        projectPages.map((p) => (
          <li>
            <a class="project-row" href={L(`/${p.slug}`)} data-project={p.slug}>
              <span class="project-row__title">{p.title}</span>
              <span class="project-row__meta dim">{p.meta}</span>
              <span class="project-row__line">{p.line}</span>
              <span class="project-row__slot" data-slot={`row-${p.slug}`} aria-hidden="true"></span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Below 960px rows are one column and the objects stay in the hero. */
  .project-row__slot {
    display: none;
  }

  .project-list {
    list-style: none;
    margin-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .project-row {
    display: grid;
    gap: var(--space-2) var(--space-7);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
  }

  /* The next section draws its own top line, so the last row has none (no double line). */
  .project-list li:last-child .project-row {
    border-bottom: 0;
  }

  @media (min-width: 960px) {
    .project-row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) 180px;
      grid-template-areas: 'title line slot' 'meta line slot';
      align-items: start;
    }

    .project-row__title {
      grid-area: title;
    }

    .project-row__meta {
      grid-area: meta;
    }

    .project-row__line {
      grid-area: line;
    }

    .project-row__slot {
      display: block;
      grid-area: slot;
      width: 180px;
      aspect-ratio: 1;
    }
  }



  .project-row__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    line-height: 1.2;
    color: var(--accent);
  }

  .project-row:hover .project-row__title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .project-row__line {
    color: var(--text);
  }
</style>
