---
import { mizan, ui } from '../content/site';
---
<article id="mizan" class="project" aria-labelledby="mizan-title">
  <h3 id="mizan-title" class="project-title">{mizan.title}</h3>
  <p class="meta">{ui.mizan.meta}</p>

  <ul class="bullets mizan__bullets">
    {mizan.bullets.map((bullet) => <li>{bullet}</li>)}
  </ul>

  {
    (mizan.codeUrl || mizan.liveAppUrl) && (
      <ul class="links">
        {mizan.codeUrl && (
          <li>
            <a href={mizan.codeUrl}>{ui.mizan.code}</a>
          </li>
        )}
        {mizan.liveAppUrl && (
          <li>
            <a href={mizan.liveAppUrl}>{ui.mizan.liveApp}</a>
          </li>
        )}
      </ul>
    )
  }
</article>

<style>
  .mizan__bullets {
    margin-top: var(--space-5);
  }
</style>
