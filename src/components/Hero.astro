---
import { identity, proofChips, ui } from '../content/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero__grid wide">
      <div class="hero__text">
        <h1 id="hero-title" class="hero__name">{identity.name}</h1>
        {identity.tagline && <p class="hero__tagline">{identity.tagline}</p>}
        <p class="hero__subline">
          {
            ui.heroSubline.map((line) => (
              <span class="hero__line">
                {line.split(' · ').map((part, i) => (
                  <>
                    {i > 0 && <span class="hero__sep"> · </span>}
                    <span class="hero__part">{part}</span>
                  </>
                ))}
              </span>
            ))
          }
        </p>

        {
          proofChips.length > 0 && (
            <p class="hero__proof">
              {proofChips.map((item, i) => (
                <>
                  {i > 0 && <span class="hero__sep"> · </span>}
                  <span class="hero__item">{item}</span>
                </>
              ))}
            </p>
          )
        }

        <p class="hero__drop">
          <span class="hero__drop-text">{ui.eyeGate.hint} </span><a href="/retina#gate">{ui.eyeGate.hintLink}</a>
        </p>

        <div class="hero__actions">
          <a id="view-work" class="btn btn-primary" href="#projects">{ui.hero.viewWork}</a>
          {
            identity.cvHref && (
              <a class="hero__cv" href={identity.cvHref} download>
                {ui.hero.downloadCv}
              </a>
            )
          }
        </div>
      </div>

      <!-- Empty slots; the three project objects are drawn over them by ProjectScene. -->
      <div class="hero__slots" aria-hidden="true">
        <span class="slot slot--mizan" data-slot="hero-mizan"></span>
        <span class="slot slot--retina" data-slot="hero-retina"></span>
        <span class="slot slot--hcgcc" data-slot="hero-hcgcc"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 8vw, 96px) clamp(48px, 8vw, 96px);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      min-height: min(72vh, 680px);
    }
  }

  /* Fixed-size slots, so nothing shifts when the 3D scene loads. */
  .hero__slots {
    position: relative;
    height: 340px;
  }

  @media (min-width: 960px) {
    .hero__slots {
      height: min(72vh, 620px);
    }
  }

  .slot {
    position: absolute;
    aspect-ratio: 1;
  }

  .slot--retina {
    left: 50%;
    top: 50%;
    width: min(340px, 90%);
    transform: translate(-50%, -50%);
  }

  .slot--mizan,
  .slot--hcgcc {
    display: none;
  }

  @media (min-width: 768px) {
    .slot--retina {
      left: 30%;
      top: 22%;
      width: 44%;
      transform: none;
    }

    .slot--mizan {
      display: block;
      left: 0;
      top: 2%;
      width: 30%;
    }

    .slot--hcgcc {
      display: block;
      right: 0;
      bottom: 2%;
      width: 30%;
    }
  }

  /* The tagline says what Yousef does, so it sits right under the name and is
     nearly as large; the name is kept a step smaller than other page titles. */
  .hero__name {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    letter-spacing: -0.02em;
  }

  .hero__tagline {
    font-size: clamp(1.5rem, 3.4vw, 2.25rem);
    line-height: 1.25;
    margin-top: var(--space-3);
    text-wrap: balance;
  }

  .hero__subline {
    color: var(--text-dim);
    margin-top: var(--space-5);
  }

  .hero__line {
    display: block;
  }

  /* On narrow screens, stack "School · Class of 2028" instead of wrapping
     with a dangling separator. Text is unchanged. */
  @media (max-width: 479px) {
    .hero__subline .hero__sep {
      display: none;
    }

    .hero__part {
      display: block;
    }
  }

  .hero__proof {
    margin-top: var(--space-5);
  }

  /* Keep each item whole when the line wraps. */
  .hero__item {
    white-space: nowrap;
  }

  .hero__drop {
    margin-top: var(--space-5);
    color: var(--text-dim);
    font-size: var(--step--1);
  }

  .hero__drop a {
    font-weight: 600;
  }

  /* Touch screens can't drag a file onto the eye; keep only the link. */
  @media (hover: none) {
    .hero__drop-text {
      display: none;
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-7);
  }

  .hero__cv {
    font-weight: 600;
  }
</style>
