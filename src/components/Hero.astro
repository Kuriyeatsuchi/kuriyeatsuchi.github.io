---
import { identity, proofChips, ui } from '../content/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <h1 id="hero-title" class="hero__name">{identity.name}</h1>
    {identity.tagline && <p class="hero__tagline">{identity.tagline}</p>}
    <p class="hero__subline">
      {
        ui.heroSubline.map((line) => (
          <span class="hero__line">
            {line.split(' · ').map((part, i) => (
              <>
                {i > 0 && <span class="hero__sep"> · </span>}
                <span class="hero__part">{part}</span>
              </>
            ))}
          </span>
        ))
      }
    </p>

    {
      proofChips.length > 0 && (
        <p class="hero__proof">
          {proofChips.map((item, i) => (
            <>
              {i > 0 && <span class="hero__sep"> · </span>}
              <span class="hero__item">{item}</span>
            </>
          ))}
        </p>
      )
    }

    <div class="hero__actions">
      <a class="btn btn-primary" href="#projects">{ui.hero.viewWork}</a>
      {
        identity.cvHref && (
          <a class="hero__cv" href={identity.cvHref} download>
            {ui.hero.downloadCv}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(48px, 12vw, 144px) clamp(64px, 10vw, 112px);
  }

  /* The tagline says what Yousef does, so it sits right under the name and is
     nearly as large; the name is kept a step smaller than other page titles. */
  .hero__name {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    letter-spacing: -0.02em;
  }

  .hero__tagline {
    font-size: clamp(1.5rem, 3.6vw, 2.25rem);
    line-height: 1.25;
    margin-top: var(--space-3);
    text-wrap: balance;
  }

  .hero__subline {
    color: var(--text-dim);
    margin-top: var(--space-5);
  }

  .hero__line {
    display: block;
  }

  /* On narrow screens, stack "School · Class of 2028" instead of wrapping
     with a dangling separator. Text is unchanged. */
  @media (max-width: 479px) {
    .hero__subline .hero__sep {
      display: none;
    }

    .hero__part {
      display: block;
    }
  }

  .hero__proof {
    margin-top: var(--space-5);
  }

  /* Keep each item whole when the line wraps. */
  .hero__item {
    white-space: nowrap;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-7);
  }

  .hero__cv {
    font-weight: 600;
  }
</style>
