---
import { projectPages, ui } from '../content/site';

interface Props {
  current: (typeof projectPages)[number]['slug'];
}

const { current } = Astro.props;
const i = projectPages.findIndex((p) => p.slug === current);
const next = projectPages[(i + 1) % projectPages.length];
---
<nav class="section project-nav" aria-label={ui.pages.navLabel}>
  <div class="container project-nav__inner">
    <a href="/#projects">{ui.pages.allProjects}</a>
    {next && next.slug !== current && (
      <a class="project-nav__next" href={`/${next.slug}`}>
        <span class="dim">{ui.pages.nextProject}</span>
        <span>{next.title}</span>
      </a>
    )}
  </div>
</nav>

<style>
  .project-nav__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-5);
    font-weight: 600;
  }

  .project-nav__next {
    display: flex;
    flex-direction: column;
    text-align: right;
    font-family: var(--font-heading);
    font-size: var(--step-1);
  }

  .project-nav__next .dim {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 400;
  }
</style>
