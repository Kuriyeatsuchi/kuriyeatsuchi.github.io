---
import { retina, ui } from '../content/site';

// Results (AUCs, CIs, CV range) and the data statement stay hidden until
// CONTENT.md has dataset size, patient split and 95% CIs. See site.ts.
// TODO(content): link to /retina once the case study page ships (v1.x).
---
<article id="retina" class="project" aria-labelledby="retina-title">
  <p class="kicker">{retina.period}</p>
  <h3 id="retina-title" class="project-title">{retina.title}</h3>
  <p class="lede">{retina.oneLine}</p>
  {retina.whyItMatters && <p class="retina__why">{retina.whyItMatters}</p>}
  <p class="retina__origin dim">{retina.origin}</p>

  <div class="retina__block">
    <h4 class="subhead">{ui.retina.stage1}</h4>
    <p class="cap">{retina.stage1}</p>
  </div>
  <div class="retina__block">
    <h4 class="subhead">{ui.retina.stage2}</h4>
    <p class="cap">{retina.stage2}</p>
  </div>

  {
    retina.stack.length > 0 && (
      <div class="retina__stack">
        <h4 class="subhead">{ui.retina.stack}</h4>
        <ul class="stack-list">
          {retina.stack.map((tool) => (
            <li>{tool}</li>
          ))}
        </ul>
      </div>
    )
  }

  <p class="disclaimer">{retina.disclaimer}</p>

  {
    retina.repoUrl && (
      <ul class="links">
        <li>
          <a href={retina.repoUrl}>{ui.retina.code}</a>
        </li>
      </ul>
    )
  }
</article>

<style>
  .retina__why,
  .retina__origin {
    margin-top: var(--space-4);
  }

  .retina__block {
    margin-top: var(--space-6);
  }

  /* Source text starts lowercase (CONTENT.md); capitalize visually only. */
  .cap::first-letter {
    text-transform: uppercase;
  }

  .retina__stack {
    margin-top: var(--space-6);
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
  }

  .disclaimer {
    margin-top: var(--space-6);
    color: var(--text-dim);
  }
</style>
