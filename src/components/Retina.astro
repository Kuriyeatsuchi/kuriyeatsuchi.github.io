---
import Rich from './Rich.astro';
import { retina, ui } from '../content/site';

// Results (AUCs, CIs, CV range) and the data statement stay hidden until
// CONTENT.md has dataset size, patient split and 95% CIs. See site.ts.
// TODO(content): link to /retina once the case study page ships (v1.x).
---
<section id="retina" class="section" aria-labelledby="retina-title">
  <div class="container">
    <p class="kicker"><Rich text={retina.period} /></p>
    <h2 id="retina-title" class="section-title">{retina.title}</h2>
    <p class="lede">{retina.oneLine}</p>
    {retina.whyItMatters && <p class="retina__why">{retina.whyItMatters}</p>}
    <p class="retina__origin dim"><Rich text={retina.origin} /></p>

    <div class="stages">
      <div class="stage">
        <h3 class="subhead">{ui.retina.stage1}</h3>
        <p class="cap"><Rich text={retina.stage1} /></p>
      </div>
      <div class="stage">
        <h3 class="subhead">{ui.retina.stage2}</h3>
        <p class="cap"><Rich text={retina.stage2} /></p>
      </div>
    </div>

    {
      retina.stack.length > 0 && (
        <div class="retina__stack">
          <h3 class="subhead">{ui.retina.stack}</h3>
          <ul class="stack-list">
            {retina.stack.map((tool) => (
              <li>{tool}</li>
            ))}
          </ul>
        </div>
      )
    }

    <p class="disclaimer">{retina.disclaimer}</p>

    {
      retina.repoUrl && (
        <ul class="links">
          <li>
            <a href={retina.repoUrl}>{ui.retina.code}</a>
          </li>
        </ul>
      )
    }
  </div>
</section>

<style>
  .retina__why,
  .retina__origin {
    margin-top: var(--space-4);
  }

  .stages {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (min-width: 640px) {
    .stages {
      grid-template-columns: 1fr 1fr;
    }
  }

  .stage {
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  /* Source text starts lowercase (CONTENT.md); capitalize visually only. */
  .cap::first-letter {
    text-transform: uppercase;
  }

  .retina__stack {
    margin-top: var(--space-6);
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
  }

  .disclaimer {
    margin-top: var(--space-6);
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--accent);
    background: var(--surface);
    font-size: var(--step--1);
  }
</style>
