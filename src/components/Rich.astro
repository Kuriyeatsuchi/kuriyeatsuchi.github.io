---
/**
 * Renders a string with every number wrapped in <span class="mono">,
 * so metrics, years and money use JetBrains Mono (design rule).
 */
import { splitNumbers } from '../utils/numbers';

interface Props {
  text: string;
}

const segments = splitNumbers(Astro.props.text);
---
{segments.map((s) => (s.isNumber ? <span class="mono">{s.text}</span> : s.text))}
