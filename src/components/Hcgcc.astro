---
import Rich from './Rich.astro';
import { hcgcc, ui } from '../content/site';

// The deck opens at page 2 so the cover slide (logos) isn't the first thing shown.
// Chrome and Firefox honor #page=2; Safari opens at page 1.
const deckEmbedSrc = hcgcc.deckHref ? `${hcgcc.deckHref}#page=2` : null;
---
<section id="hcgcc" class="section" aria-labelledby="hcgcc-title">
  <div class="container">
    <p class="kicker"><Rich text={hcgcc.competition} /></p>
    <h2 id="hcgcc-title" class="section-title">{hcgcc.title}</h2>
    <p class="hcgcc__result"><Rich text={hcgcc.result} /></p>
    <p class="hcgcc__team dim">{hcgcc.teamCredit}</p>

    <ul class="numbers">
      {
        hcgcc.headlineNumbers.map((n) => (
          <li class="number">
            <span class="number__value mono">{n.value}</span>
            <span class="number__label">
              <Rich text={n.label} />
            </span>
          </li>
        ))
      }
    </ul>

    <div class="hcgcc__block">
      <h3 class="subhead">{ui.hcgcc.theCase}</h3>
      <p><Rich text={hcgcc.theCase} /></p>
    </div>

    <div class="hcgcc__block">
      <h3 class="subhead">{ui.hcgcc.ourAnswer}</h3>
      <p>{hcgcc.answerIntro}</p>
      <ul class="bullets hcgcc__plan">
        {
          hcgcc.plan.map((part) => (
            <li>
              <strong>{part.name}</strong>: <Rich text={part.text} />
            </li>
          ))
        }
      </ul>
    </div>

    {hcgcc.myRole && <p class="hcgcc__block">{hcgcc.myRole}</p>}

    {
      hcgcc.deckHref && deckEmbedSrc && (
        <div class="deck">
          <div
            class="deck__frame"
            data-deck-src={deckEmbedSrc}
            data-deck-title={ui.hcgcc.deckFrameTitle}
          />
          <ul class="links deck__links">
            <li>
              <a href={hcgcc.deckHref}>{ui.hcgcc.openDeck}</a>
            </li>
            <li>
              <a href={hcgcc.deckHref} download>
                {ui.hcgcc.downloadDeck}
              </a>
            </li>
          </ul>
        </div>
      )
    }
  </div>
</section>

<script>
  // Embed the PDF only on larger screens with a fine pointer. Mobile browsers
  // don't render PDF iframes reliably, and this avoids downloading the deck
  // on phones. The CSS reserves the frame's space under the same query.
  const QUERY = '(min-width: 768px) and (pointer: fine)';
  const frame = document.querySelector<HTMLElement>('[data-deck-src]');

  function embed(): void {
    if (!frame || frame.querySelector('iframe')) return;
    const src = frame.dataset.deckSrc;
    if (!src) return;
    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = frame.dataset.deckTitle ?? '';
    iframe.loading = 'lazy';
    frame.append(iframe);
  }

  const mq = window.matchMedia(QUERY);
  if (mq.matches) embed();
  mq.addEventListener('change', (e) => {
    if (e.matches) embed();
  });
</script>

<style>
  .hcgcc__result {
    margin-top: var(--space-4);
    font-size: var(--step-1);
    font-weight: 600;
  }

  .hcgcc__team {
    margin-top: var(--space-2);
  }

  .numbers {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    margin-top: var(--space-6);
  }

  @media (min-width: 640px) {
    .numbers {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .number {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .number__value {
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--accent);
  }

  .number__label {
    color: var(--text-dim);
    font-size: var(--step--1);
  }

  .hcgcc__block {
    margin-top: var(--space-6);
  }

  .hcgcc__plan {
    margin-top: var(--space-4);
  }

  .deck {
    margin-top: var(--space-7);
  }

  .deck__frame {
    display: none;
  }

  @media (min-width: 768px) and (pointer: fine) {
    :global(.js) .deck__frame {
      display: block;
      aspect-ratio: 16 / 10;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      background: var(--surface);
    }
  }

  .deck__frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .deck__links {
    margin-top: var(--space-4);
  }
</style>
