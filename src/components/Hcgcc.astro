---
import { hcgcc, ui } from '../content/site';

// Slide 2 of the deck, rendered with pdftoppm and converted to WebP, unedited.
// Showing the deck's own logos here is an approved exception to rule 4
// (the rule covers logos/mascots used as decoration). See CONTENT.md.
const slide = {
  src: '/images/hcgcc-slide-2-1440.webp',
  srcset: '/images/hcgcc-slide-2-720.webp 720w, /images/hcgcc-slide-2-1440.webp 1440w',
  sizes: '(min-width: 800px) 720px, calc(100vw - 32px)',
  width: 1440,
  height: 810,
};
---
<section id="hcgcc" class="section" aria-labelledby="hcgcc-title">
  <div class="container">
    <p class="kicker">{hcgcc.competition}</p>
    <h2 id="hcgcc-title" class="section-title">{hcgcc.title}</h2>
    <p class="hcgcc__result">{hcgcc.result}</p>
    <p class="hcgcc__team dim">{hcgcc.teamCredit}</p>

    <ul class="figures">
      {
        hcgcc.headlineNumbers.map((n) => (
          <li>
            <span class="figures__value mono">{n.value}</span>
            <span class="figures__label">{n.label}</span>
          </li>
        ))
      }
    </ul>

    <div class="hcgcc__block">
      <h3 class="subhead">{ui.hcgcc.theCase}</h3>
      <p>{hcgcc.theCase}</p>
    </div>

    <div class="hcgcc__block">
      <h3 class="subhead">{ui.hcgcc.ourAnswer}</h3>
      <p>{hcgcc.answerIntro}</p>
      <ul class="bullets hcgcc__plan">
        {
          hcgcc.plan.map((part) => (
            <li>
              <strong>{part.name}</strong>: {part.text}
            </li>
          ))
        }
      </ul>
    </div>

    {hcgcc.myRole && <p class="hcgcc__block">{hcgcc.myRole}</p>}

    {
      hcgcc.deckHref && (
        <div class="deck">
          <a class="deck__preview" href={hcgcc.deckHref}>
            <img
              src={slide.src}
              srcset={slide.srcset}
              sizes={slide.sizes}
              width={slide.width}
              height={slide.height}
              alt={ui.hcgcc.slideAlt}
              loading="lazy"
              decoding="async"
            />
          </a>
          <ul class="links deck__links">
            <li>
              <a href={hcgcc.deckHref}>{ui.hcgcc.openDeck}</a>
            </li>
            <li>
              <a href={hcgcc.deckHref} download>
                {ui.hcgcc.downloadDeck}
              </a>
            </li>
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .hcgcc__result {
    margin-top: var(--space-4);
    font-size: var(--step-1);
    font-weight: 600;
  }

  .hcgcc__team {
    margin-top: var(--space-2);
  }

  /* Headline numbers: a plain row, no boxes. Stacks on narrow screens. */
  .figures {
    display: grid;
    gap: var(--space-4) var(--space-6);
    list-style: none;
    margin-top: var(--space-6);
  }

  @media (min-width: 640px) {
    .figures {
      grid-template-columns: repeat(3, auto);
      justify-content: start;
    }
  }

  .figures li {
    display: flex;
    flex-direction: column;
  }

  .figures__value {
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .figures__label {
    color: var(--text-dim);
  }

  .hcgcc__block {
    margin-top: var(--space-6);
  }

  .hcgcc__plan {
    margin-top: var(--space-4);
  }

  .deck {
    margin-top: var(--space-7);
  }

  .deck__preview {
    display: block;
    border: 1px solid var(--border);
  }

  .deck__preview img {
    width: 100%;
    height: auto;
  }

  .deck__links {
    margin-top: var(--space-4);
  }
</style>
