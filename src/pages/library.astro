---
import Base from '../layouts/Base.astro';
import { type LibraryCategory, type LibraryEntry } from '../content/library';
import { content, langOf } from '../content/i18n';

const lang = langOf(Astro.url);
const { ui, library } = content(lang);

const L = ui.library;
const order: LibraryCategory[] = ['award', 'competition', 'program', 'course'];
const counts = Object.fromEntries(order.map((c) => [c, library.filter((e) => e.category === c).length])) as Record<
  LibraryCategory,
  number
>;

// Newest year first; undated entries last. Within a year, newest first.
const groups = new Map<string, LibraryEntry[]>();
for (const e of [...library].sort((a, b) => b.sort.localeCompare(a.sort))) {
  const key = e.year === null ? L.undated : String(e.year);
  groups.set(key, [...(groups.get(key) ?? []), e]);
}
const years = library.map((e) => e.year).filter((y): y is number => y !== null);
const span = `${Math.min(...years)}–${Math.max(...years)}`;
const viewLabel = (n: number): string => (n === 1 ? L.viewOne : L.viewMany.replace('{n}', String(n)));
---
<Base title={`${L.heading} · ${ui.meta.title}`} description={L.intro} canonicalPath="/library">
  <header class="page-head lib-head">
    <div class="container">
      <h1 class="page-title">{L.heading}</h1>
      <p class="intro lib-intro">{L.intro}</p>
      <p class="lib-total"><span class="mono">{library.length}</span> {L.entries} · <span class="mono">{span}</span></p>
    </div>
  </header>

  <div class="lib-bar" data-lib-bar>
    <div class="container">
      <div class="lib-bar__inner wide">
        <label class="lib-search">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <span class="visually-hidden">{L.searchLabel}</span>
          <input type="search" placeholder={L.searchPlaceholder} autocomplete="off" spellcheck="false" data-lib-search />
        </label>
        <div class="lib-filters" role="group" aria-label={L.filterLabel}>
          <button type="button" aria-pressed="true" data-filter="all">{L.all} <span class="mono">{library.length}</span></button>
          {
            order.map((c) => (
              <button type="button" aria-pressed="false" data-filter={c}>
                {L.plural[c]} <span class="mono">{counts[c]}</span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <section class="section lib-list-section" aria-label={L.listLabel}>
    <div class="container">
      <p class="lib-status small dim wide" aria-live="polite" data-lib-status></p>
      <div class="lib-list wide" data-lib-list>
        {
          [...groups.entries()].map(([year, entries]) => (
            <section class="lib-year" data-year aria-label={year}>
              <h2 class:list={['lib-year__label mono', { 'lib-year__label--word': !/^\d+$/.test(year) }]}>{year}</h2>
              <ol class="lib-rows">
                {entries.map((e) => (
                  <li
                    class="lib-row"
                    id={e.slug}
                    data-entry={e.slug}
                    data-category={e.category}
                    data-search={`${e.title} ${e.detail} ${e.issuer} ${e.year ?? ''} ${L.singular[e.category]}`.toLowerCase()}
                  >
                    <a class="lib-row__link" href={e.files[0]?.src} data-open={e.slug}>
                      <span class="lib-row__thumb" aria-hidden="true">
                        <img src={e.files[0]?.thumb} width="240" height="170" alt="" loading="lazy" decoding="async" />
                        {e.files.length > 1 && <span class="lib-row__stack mono">{e.files.length}</span>}
                      </span>
                      <span class="lib-row__text">
                        <span class="lib-row__title">{e.title}</span>
                        <span class="lib-row__detail">{e.detail}</span>
                        <span class="lib-row__issuer">{e.issuer}</span>
                      </span>
                      <span class="lib-row__meta">
                        <span class="lib-row__type">{L.singular[e.category]}</span>
                        <span class="lib-row__view">{viewLabel(e.files.length)} <span aria-hidden="true">→</span></span>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))
        }
      </div>
      <p class="lib-empty dim" hidden data-lib-empty></p>
    </div>
  </section>

  <dialog class="viewer" aria-labelledby="viewer-title" data-viewer>
    <div class="viewer__inner">
      <figure class="viewer__stage">
        <img alt="" data-viewer-img />
        <figcaption class="visually-hidden" data-viewer-alt></figcaption>
      </figure>
      <aside class="viewer__side">
        <p class="viewer__type" data-viewer-type></p>
        <h2 id="viewer-title" class="viewer__title" data-viewer-title></h2>
        <p class="viewer__detail" data-viewer-detail></p>
        <p class="viewer__issuer dim" data-viewer-issuer></p>
        <p class="viewer__year mono dim" data-viewer-year></p>
        <div class="viewer__pages" data-viewer-pages></div>
        <div class="viewer__nav">
          <button type="button" class="btn-line" data-viewer-prev>{L.previous}</button>
          <button type="button" class="btn-line" data-viewer-next>{L.next}</button>
        </div>
        <p class="viewer__hint small dim">{L.keysHint}</p>
        <a class="viewer__full" href="#" target="_blank" rel="noopener" data-viewer-full>{L.openFull}</a>
      </aside>
      <button type="button" class="viewer__close" data-viewer-close aria-label={L.close}>
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 5l14 14M19 5 5 19"></path></svg>
      </button>
    </div>
  </dialog>
</Base>

<script>
  import { content, pageLang } from '../content/i18n';
  const { ui, library } = content(pageLang());

  const L = ui.library;
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-entry]'));
  const yearsEls = Array.from(document.querySelectorAll<HTMLElement>('[data-year]'));
  const search = document.querySelector<HTMLInputElement>('[data-lib-search]');
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const status = document.querySelector<HTMLElement>('[data-lib-status]');
  const empty = document.querySelector<HTMLElement>('[data-lib-empty]');
  const bar = document.querySelector<HTMLElement>('[data-lib-bar]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let category = 'all';

  /* ---------- filter + search ---------- */
  const apply = (): void => {
    const q = (search?.value ?? '').trim().toLowerCase();
    const words = q.split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const r of rows) {
      const ok =
        (category === 'all' || r.dataset.category === category) &&
        words.every((w) => (r.dataset.search ?? '').includes(w));
      r.hidden = !ok;
      if (ok) shown++;
    }
    for (const y of yearsEls) y.hidden = !y.querySelector('[data-entry]:not([hidden])');
    if (status) status.textContent = L.showing.replace('{shown}', String(shown)).replace('{total}', String(rows.length));
    if (empty) {
      empty.hidden = shown > 0;
      empty.textContent = q ? L.noMatchQuery.replace('{q}', q) : L.noMatch;
    }
  };
  for (const f of filters) {
    f.addEventListener('click', () => {
      category = f.dataset.filter ?? 'all';
      for (const g of filters) g.setAttribute('aria-pressed', g === f ? 'true' : 'false');
      apply();
    });
  }
  search?.addEventListener('input', apply);
  apply();

  // The bar gets a hairline once it sticks.
  if (bar) {
    const sentinel = document.createElement('div');
    bar.before(sentinel);
    new IntersectionObserver(([e]) => bar.classList.toggle('is-stuck', !e?.isIntersecting)).observe(sentinel);
  }

  /* ---------- viewer ---------- */
  const dialog = document.querySelector<HTMLDialogElement>('[data-viewer]');
  if (dialog && typeof dialog.showModal === 'function') {
    const $ = <T extends Element>(s: string): T => dialog.querySelector<T>(s) as T;
    const img = $<HTMLImageElement>('[data-viewer-img]');
    const pages = $<HTMLElement>('[data-viewer-pages]');
    let entryIndex = 0;
    let page = 0;
    let visible: typeof library[number][] = [];

    const visibleEntries = (): typeof library[number][] =>
      rows.filter((r) => !r.hidden).map((r) => library.find((e) => e.slug === r.dataset.entry)).filter((e): e is typeof library[number] => !!e);

    const render = (): void => {
      const e = visible[entryIndex];
      if (!e) return;
      const f = e.files[page] ?? e.files[0];
      if (!f) return;
      img.src = f.src;
      img.width = f.width;
      img.height = f.height;
      img.alt = `${e.title}, ${L.certificate} ${page + 1} / ${e.files.length}`;
      $<HTMLElement>('[data-viewer-type]').textContent = L.singular[e.category];
      $<HTMLElement>('[data-viewer-title]').textContent = e.title;
      $<HTMLElement>('[data-viewer-detail]').textContent = e.detail;
      $<HTMLElement>('[data-viewer-issuer]').textContent = e.issuer;
      $<HTMLElement>('[data-viewer-year]').textContent = e.year === null ? L.undated : String(e.year);
      $<HTMLAnchorElement>('[data-viewer-full]').href = f.src;
      pages.replaceChildren(
        ...(e.files.length > 1
          ? e.files.map((file, i) => {
              const b = document.createElement('button');
              b.type = 'button';
              b.className = 'viewer__page';
              b.setAttribute('aria-label', `${L.certificate} ${i + 1}`);
              b.setAttribute('aria-current', i === page ? 'true' : 'false');
              const t = document.createElement('img');
              t.src = file.thumb;
              t.alt = '';
              b.append(t);
              b.addEventListener('click', () => {
                page = i;
                render();
              });
              return b;
            })
          : []),
      );
      history.replaceState(null, '', `#${e.slug}`);
      // Phones: each certificate starts at the top of the scrolling column.
      dialog.querySelector('.viewer__inner')?.scrollTo(0, 0);
    };

    const step = (dir: 1 | -1): void => {
      const e = visible[entryIndex];
      if (!e) return;
      if (page + dir >= 0 && page + dir < e.files.length) page += dir;
      else {
        entryIndex = (entryIndex + dir + visible.length) % visible.length;
        page = dir === 1 ? 0 : (visible[entryIndex]?.files.length ?? 1) - 1;
      }
      render();
      if (!reduced) img.animate([{ opacity: 0, transform: `translateX(${dir * 24}px)` }, { opacity: 1, transform: 'none' }], { duration: 220, easing: 'cubic-bezier(.2,.7,.2,1)' });
    };

    const open = (slug: string, from?: HTMLElement | null): void => {
      visible = visibleEntries();
      if (!visible.some((e) => e.slug === slug)) visible = [...library];
      entryIndex = Math.max(0, visible.findIndex((e) => e.slug === slug));
      page = 0;
      render();
      dialog.showModal();
      document.documentElement.classList.add('viewer-open');
      // Grow the certificate out of its thumbnail.
      if (from && !reduced) {
        const a = from.getBoundingClientRect();
        requestAnimationFrame(() => {
          const b = img.getBoundingClientRect();
          if (!b.width) return;
          const sx = a.width / b.width;
          const sy = a.height / b.height;
          img.animate(
            [
              { transform: `translate(${a.left - b.left}px, ${a.top - b.top}px) scale(${sx}, ${sy})`, opacity: 0.4 },
              { transform: 'none', opacity: 1 },
            ],
            { duration: 380, easing: 'cubic-bezier(.2,.75,.2,1)', fill: 'backwards' },
          );
        });
      }
    };

    const close = (): void => {
      dialog.close();
    };
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('viewer-open');
      const e = visible[entryIndex];
      history.replaceState(null, '', location.pathname);
      if (e) document.querySelector<HTMLElement>(`[data-open="${e.slug}"]`)?.focus({ preventScroll: true });
    });

    for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-open]')) {
      a.addEventListener('click', (ev) => {
        if (ev.metaKey || ev.ctrlKey || ev.shiftKey) return;
        ev.preventDefault();
        open(a.dataset.open ?? '', a.querySelector('img'));
      });
    }
    $<HTMLButtonElement>('[data-viewer-close]').addEventListener('click', close);
    $<HTMLButtonElement>('[data-viewer-prev]').addEventListener('click', () => step(-1));
    $<HTMLButtonElement>('[data-viewer-next]').addEventListener('click', () => step(1));
    dialog.addEventListener('click', (ev) => {
      if (ev.target === dialog) close();
    });
    dialog.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowRight') step(1);
      if (ev.key === 'ArrowLeft') step(-1);
    });

    // Phones: swipe the certificate sideways to move between certificates. A swipe toward the
    // reading start (left in English, right in Arabic) goes to the next one.
    const stage = $<HTMLElement>('.viewer__stage');
    let sx = 0;
    let sy = 0;
    stage.addEventListener('touchstart', (ev) => {
      const t = ev.touches[0];
      if (t) [sx, sy] = [t.clientX, t.clientY];
    }, { passive: true });
    stage.addEventListener('touchend', (ev) => {
      const t = ev.changedTouches[0];
      if (!t) return;
      const dx = t.clientX - sx;
      const dy = t.clientY - sy;
      if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
      const rtl = document.documentElement.dir === 'rtl';
      step((dx < 0) !== rtl ? 1 : -1);
    }, { passive: true });

    // Open straight from a shared link: /library#athka-2024
    const fromHash = decodeURIComponent(location.hash.slice(1));
    if (fromHash && library.some((e) => e.slug === fromHash)) open(fromHash);
  }
</script>

<style>
  .lib-head {
    padding-bottom: var(--space-7);
  }

  .lib-intro {
    font-size: var(--step-1);
    max-width: 40ch;
  }

  .lib-total {
    margin-top: var(--space-5);
    color: var(--text-dim);
  }

  /* ---------- sticky controls ---------- */
  .lib-bar {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--bg);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease;
  }

  .lib-bar:global(.is-stuck) {
    border-bottom-color: var(--border);
  }

  .lib-bar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-4);
  }

  .lib-search {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: 1 1 260px;
    max-width: 420px;
    border-bottom: 1px solid var(--border-strong);
    color: var(--text-dim);
    transition: border-color 150ms ease;
  }

  .lib-search:focus-within {
    border-color: var(--text);
    color: var(--text);
  }

  .lib-search input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    background: none;
    border: 0;
    color: var(--text);
    font: inherit;
    outline: none;
  }

  .lib-search input::placeholder {
    color: var(--text-dim);
  }

  .lib-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .lib-filters button {
    min-height: 40px;
    padding: 0 var(--space-4);
    background: none;
    border: 0;
    border-inline-start: 1px solid var(--border-strong);
    color: var(--text-dim);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .lib-filters button:first-child {
    border-inline-start: 0;
  }

  .lib-filters button:hover {
    color: var(--text);
  }

  /* Selected filter: raised surface and an underline, not a filled button. */
  .lib-filters button[aria-pressed='true'] {
    background: var(--surface);
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--text);
  }

  .lib-filters .mono {
    margin-inline-start: 4px;
    opacity: 0.7;
  }

  /* ---------- list ---------- */
  .lib-list-section {
    padding-top: var(--space-5);
    border-top: 0;
  }

  .lib-status {
    margin-bottom: var(--space-5);
  }

  .lib-year {
    display: grid;
    gap: var(--space-3) var(--space-6);
    border-top: 1px solid var(--border);
    padding-top: var(--space-5);
    margin-bottom: var(--space-7);
  }

  @media (min-width: 960px) {
    .lib-year {
      grid-template-columns: 140px minmax(0, 1fr);
    }

    /* The year rides along while its entries scroll past. */
    .lib-year__label {
      position: sticky;
      top: 96px;
      align-self: start;
    }
  }

  /* Filtering hides whole years; [hidden] must beat the grid display above. */
  .lib-year[hidden],
  .lib-row[hidden] {
    display: none;
  }

  .lib-year__label--word {
    font-size: var(--step-1) !important;
    padding-top: 0.4em;
  }

  .lib-year__label {
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1;
    font-weight: 400;
    color: var(--text-dim);
    letter-spacing: -0.03em;
  }

  .lib-rows {
    list-style: none;
  }

  .lib-row + .lib-row {
    border-top: 1px solid var(--border);
  }

  .lib-row__link {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: var(--space-2) var(--space-5);
    align-items: center;
    padding-block: var(--space-4);
    color: var(--text);
    text-decoration: none;
  }

  @media (min-width: 720px) {
    .lib-row__link {
      grid-template-columns: 112px minmax(0, 1fr) auto;
    }
  }

  .lib-row__thumb {
    position: relative;
    display: block;
    aspect-ratio: 24 / 17;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .lib-row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(0.7);
    transform: scale(1.04);
    transition: filter 300ms ease, transform 400ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .lib-row__link:hover .lib-row__thumb img,
  .lib-row__link:focus-visible .lib-row__thumb img {
    filter: none;
    transform: none;
  }

  /* A small count when one entry holds several certificates. */
  .lib-row__stack {
    position: absolute;
    inset-inline-end: 4px;
    bottom: 4px;
    padding: 0 5px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .lib-row__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .lib-row__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.3;
    transition: color 150ms ease;
  }

  .lib-row__link:hover .lib-row__title {
    color: var(--accent);
  }

  .lib-row__detail {
    color: var(--text);
    font-size: var(--step--1);
  }

  .lib-row__issuer {
    color: var(--text-dim);
    font-size: var(--step--1);
  }

  .lib-row__meta {
    grid-column: 2;
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    font-size: var(--step--1);
  }

  @media (min-width: 720px) {
    .lib-row__meta {
      grid-column: 3;
      flex-direction: column;
      align-items: flex-end;
      gap: var(--space-1);
      text-align: end;
    }
  }

  .lib-row__type {
    color: var(--text-dim);
  }

  .lib-row__view {
    color: var(--accent);
    font-weight: 600;
    white-space: nowrap;
  }

  .lib-row__view span {
    display: inline-block;
    transition: transform 200ms ease;
  }

  .lib-row__link:hover .lib-row__view span {
    transform: translateX(4px);
  }

  /* Right-to-left (Arabic): the arrow points left and nudges left. */
  :global([dir='rtl']) .lib-row__view span {
    transform: scaleX(-1);
  }

  :global([dir='rtl']) .lib-row__link:hover .lib-row__view span {
    transform: scaleX(-1) translateX(4px);
  }

  .lib-empty {
    padding-block: var(--space-7);
  }

  /* ---------- viewer ---------- */
  .viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
  }

  /* Solid backdrop: the Library list must not show through behind the certificate. */
  .viewer::backdrop {
    background: var(--bg);
  }

  .viewer__inner {
    position: relative;
    display: grid;
    height: 100%;
    gap: var(--space-5);
    padding: clamp(16px, 4vw, 48px);
    background: var(--bg);
  }

  @media (min-width: 960px) {
    .viewer__inner {
      grid-template-columns: minmax(0, 1fr) 320px;
      grid-template-rows: minmax(0, 1fr);
      gap: var(--space-7);
    }

    .viewer__stage img {
      max-height: calc(100dvh - 2 * clamp(16px, 4vw, 48px));
    }
  }

  .viewer__stage {
    display: grid;
    place-items: center;
    min-height: 0;
  }

  .viewer__stage img {
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    background: #fff;
    box-shadow: 0 30px 80px var(--shadow);
  }

  .viewer__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-self: end;
    overflow: auto;
  }

  @media (min-width: 960px) {
    .viewer__side {
      align-self: center;
    }
  }

  .viewer__type {
    color: var(--text-dim);
    font-size: var(--step--1);
  }

  .viewer__title {
    font-size: var(--step-2);
    line-height: 1.2;
  }

  .viewer__pages {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .viewer__pages:empty {
    display: none;
  }

  .viewer__pages :global(.viewer__page) {
    width: 64px;
    padding: 0;
    border: 1px solid var(--border-strong);
    background: none;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 150ms ease, border-color 150ms ease;
  }

  .viewer__pages :global(.viewer__page[aria-current='true']),
  .viewer__pages :global(.viewer__page:hover) {
