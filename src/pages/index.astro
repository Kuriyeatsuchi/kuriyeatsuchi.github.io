---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Mizan from '../components/Mizan.astro';
import Retina from '../components/Retina.astro';
import CompetitiveProgramming from '../components/CompetitiveProgramming.astro';
import { competitiveProgramming, ui } from '../content/site';
---
<Base title={ui.meta.title} description={ui.meta.description} canonicalPath="/">
  <Hero />
  <Mizan />
  <Retina />
  {competitiveProgramming.problems.length > 0 && <CompetitiveProgramming />}
</Base>
