---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import CompetitiveProgramming from '../components/CompetitiveProgramming.astro';
import Achievements from '../components/Achievements.astro';
import Contact from '../components/Contact.astro';
import ProjectScene from '../components/ProjectScene.astro';
import { content, langOf } from '../content/i18n';

const lang = langOf(Astro.url);
const { competitiveProgramming, ui } = content(lang);
---
<Base title={ui.meta.title} description={ui.meta.description} canonicalPath="/">
  <ProjectScene />
  <Hero />
  <Projects />
  {competitiveProgramming.problems.length > 0 && <CompetitiveProgramming />}
  <Achievements />
  <Contact />
</Base>
