---
import Base from '../layouts/Base.astro';
import ProjectNav from '../components/ProjectNav.astro';
import { content, langOf, localize } from '../content/i18n';

const lang = langOf(Astro.url);
const L = (path: string): string => localize(path, lang);
const { retina, ui } = content(lang);

const gate = ui.retinaGate;
const samples = [
  { key: 'clear', label: gate.samples.clear, src: '/retina/samples/clear.webp' },
  { key: 'blurry', label: gate.samples.blurry, src: '/retina/samples/blurry.webp' },
  { key: 'dark', label: gate.samples.dark, src: '/retina/samples/dark.webp' },
];
---
<Base title={`${retina.title} · ${ui.meta.title}`} description={retina.oneLine} canonicalPath="/retina">
  <article>
    <header class="page-head">
      <div class="container">
        <a class="back" href={L('/#projects')}>{ui.pages.allProjects}</a>
        <h1 class="page-title">{retina.title}</h1>
        <p class="meta">{retina.period}</p>
        <p class="lede">{retina.oneLine}</p>
        {retina.whyItMatters && <p class="block">{retina.whyItMatters}</p>}
        <p class="block dim">{retina.origin}</p>

        <div class="block">
          <h2 class="subhead">{ui.retina.stage1}</h2>
          <p class="cap">{retina.stage1}</p>
        </div>
        <div class="block">
          <h2 class="subhead">{ui.retina.stage2}</h2>
          <p class="cap">{retina.stage2}</p>
        </div>

        {
          retina.results && (
            <div class="block">
              <h2 class="subhead">{ui.retina.results}</h2>
              <ul class="figures">
                <li>
                  <span class="figures__value mono">AUC {retina.results.anyRetinopathyAuc}</span>
                  <span class="figures__label">
                    {ui.retina.anyRetinopathy}
                    {retina.results.anyRetinopathyCi && `, 95% CI ${retina.results.anyRetinopathyCi}`}
                  </span>
                </li>
                <li>
                  <span class="figures__value mono">AUC {retina.results.referableAuc}</span>
                  <span class="figures__label">
                    {ui.retina.referable}
                    {retina.results.referableCi && `, 95% CI ${retina.results.referableCi}`}
                  </span>
                </li>
              </ul>
              <p class="block-sm">{ui.retina.testSet}</p>
              <p class="block-sm dim">
                {ui.retina.crossValidation}
                {retina.results.cvRange && `; range: ${retina.results.cvRange}`}
              </p>
            </div>
          )
        }

        {
          retina.stack.length > 0 && (
            <div class="block">
              <h2 class="subhead">{ui.retina.stack}</h2>
              <ul class="stack-list">
                {retina.stack.map((tool) => <li>{tool}</li>)}
              </ul>
            </div>
          )
        }

        <p class="block dim">{retina.disclaimer}</p>
        {retina.repoUrl && <ul class="links"><li><a href={retina.repoUrl}>{ui.retina.code}</a></li></ul>}
      </div>
    </header>

    <section id="gate" class="section" aria-labelledby="gate-title">
      <div class="container">
        <h2 id="gate-title" class="section-title">{gate.heading}</h2>
        <p class="intro">{gate.intro}</p>

        <div class="gate wide" data-gate>
          <div>
            <div class="gate__drop" data-drop>
              <canvas class="gate__eye" width="320" height="320" data-eye role="img" aria-label={gate.imageLabel}></canvas>
              <p class="gate__drop-hint" aria-hidden="true">{gate.dropHere}</p>
            </div>
            <p class="small dim gate__fp"><span>{gate.fingerprint} <span class="mono" data-hash>·</span></span> <span data-dup></span></p>
            <p class="small dim gate__warn" data-warn hidden>{gate.notFundus}</p>
          </div>

          <div>
            <div class="row-buttons" role="group" aria-label={gate.sourcesLabel}>
              {
                samples.map((s, i) => (
                  <button type="button" class="btn-line" aria-pressed={i === 0 ? 'true' : 'false'} data-sample={s.src}>
                    {s.label}
                  </button>
                ))
              }
              <label class="btn-line gate__upload" data-upload-label>
                {gate.yourPhoto}
                <input type="file" accept="image/*" class="visually-hidden" data-upload />
              </label>
            </div>
            <p class="small dim gate__private">{gate.privacy}</p>

            <div class="gate__sliders">
              <div class="field">
                <label for="exposure"><span>{gate.exposure}</span> <output class="mono" data-out="exposure">0.0</output></label>
                <input id="exposure" type="range" min="-2" max="2" step="0.1" value="0" />
              </div>
              <div class="field">
                <label for="contrast"><span>{gate.contrast}</span> <output class="mono" data-out="contrast">1.00</output></label>
                <input id="contrast" type="range" min="0.2" max="1.6" step="0.05" value="1" />
              </div>
              <div class="field">
                <label for="blur"><span>{gate.blur}</span> <output class="mono" data-out="blur">0</output></label>
                <input id="blur" type="range" min="0" max="8" step="1" value="0" />
              </div>
            </div>
            <button type="button" class="gate__reset" data-reset>{gate.reset}</button>

            <table class="gate__table">
              <caption class="visually-hidden">{gate.tableCaption}</caption>
              <thead>
                <tr><th scope="col">{gate.check}</th><th scope="col">{gate.value}</th><th scope="col">{gate.allowed}</th><th scope="col">{gate.result}</th></tr>
              </thead>
              <tbody data-rows></tbody>
            </table>

            <p class="gate__verdict" aria-live="polite" data-verdict></p>
            <p class="small dim">{gate.note}</p>
            <p class="small dim">{gate.credit}</p>
          </div>
        </div>
        <noscript><p class="dim">{gate.noscript}</p></noscript>
      </div>
    </section>

    <ProjectNav current="retina" />
  </article>
</Base>

<script>
  import type { Fundus } from '../lib/quality/fundus';
  import { degrade, fingerprint, judge, measure, type Settings } from '../lib/quality/metrics';
  import { REAL_LIMITS, fundusFromFile, fundusFromUrl } from '../lib/quality/real';
  import { content, pageLang } from '../content/i18n';
  const { ui } = content(pageLang());

  const G = ui.retinaGate;
  const limits = REAL_LIMITS;
  const root = document.querySelector<HTMLElement>('[data-gate]');
  if (root) {
    const $ = <T extends Element>(s: string): T => root.querySelector<T>(s) as T;
    const canvas = $<HTMLCanvasElement>('[data-eye]');
    const ctx = canvas.getContext('2d');
    const inputs = {
      exposure: document.getElementById('exposure') as HTMLInputElement,
      contrast: document.getElementById('contrast') as HTMLInputElement,
      blur: document.getElementById('blur') as HTMLInputElement,
    };
    const sourceButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-sample]'));
    const uploadLabel = $<HTMLLabelElement>('[data-upload-label]');
    let fundus: Fundus | null = null;
    let originalHash = '';

    const settings = (): Settings => ({
      exposure: parseFloat(inputs.exposure.value),
      contrast: parseFloat(inputs.contrast.value),
      blur: parseInt(inputs.blur.value, 10),
    });

    const update = (): void => {
      if (!fundus) return;
      const s = settings();
      const px = degrade(fundus, s);
      if (ctx) {
        const img = ctx.createImageData(fundus.size, fundus.size);
        img.data.set(px);
        ctx.putImageData(img, 0, 0);
      }
      const m = measure(px, fundus);
      const problems = judge(m, limits);
      const rows: [string, string, string, boolean][] = [
        [G.brightness, m.brightness.toFixed(0), `${limits.brightness[0]} ${G.to} ${limits.brightness[1]}`,
          m.brightness >= limits.brightness[0] && m.brightness <= limits.brightness[1]],
        [G.contrastCheck, m.contrast.toFixed(2), `≥ ${limits.contrast.toFixed(2)}`, m.contrast >= limits.contrast],
        [G.sharpness, m.sharpness.toFixed(2), `≥ ${limits.sharpness.toFixed(2)}`, m.sharpness >= limits.sharpness],
      ];
      $<HTMLElement>('[data-rows]').replaceChildren(
        ...rows.map(([name, value, allowed, ok]) => {
          const tr = document.createElement('tr');
          for (const [i, text] of [name, value, allowed, ok ? G.pass : G.fail].entries()) {
            const cell = document.createElement(i === 0 ? 'th' : 'td');
            if (i === 0) cell.setAttribute('scope', 'row');
            if (i === 1 || i === 2) cell.className = 'mono';
            if (i === 3 && !ok) cell.className = 'fail';
            cell.textContent = text;
            tr.append(cell);
          }
          return tr;
        }),
      );
      $<HTMLElement>('[data-verdict]').textContent = problems.length
        ? `${G.verdictBad}: ${problems.map((p) => G.reasons[p]).join(', ')}`
        : G.verdictOk;
      const h = fingerprint(px);
      $<HTMLElement>('[data-hash]').textContent = h;
      $<HTMLElement>('[data-dup]').textContent = h === originalHash ? G.duplicate : G.notDuplicate;
      $<HTMLElement>('[data-out="exposure"]').textContent = `${s.exposure > 0 ? '+' : ''}${s.exposure.toFixed(1)}`;
      $<HTMLElement>('[data-out="contrast"]').textContent = s.contrast.toFixed(2);
      $<HTMLElement>('[data-out="blur"]').textContent = String(s.blur);
    };

    const resetSliders = (): void => {
      inputs.exposure.value = '0';
      inputs.contrast.value = '1';
      inputs.blur.value = '0';
    };

    const load = async (get: Promise<{ fundus: Fundus; looksLikeFundus: boolean } | null>, pressed: Element | null): Promise<void> => {
      const result = await get.catch(() => null);
      const warn = $<HTMLElement>('[data-warn]');
      if (!result) {
        warn.textContent = G.unreadable;
        warn.hidden = false;
        return;
      }
      warn.textContent = G.notFundus;
      warn.hidden = result.looksLikeFundus;
      fundus = result.fundus;
      originalHash = fingerprint(degrade(fundus, { exposure: 0, contrast: 1, blur: 0 }));
      for (const b of sourceButtons) b.setAttribute('aria-pressed', b === pressed ? 'true' : 'false');
      uploadLabel.toggleAttribute('data-active', pressed === uploadLabel);
      resetSliders();
      update();
    };

    for (const b of sourceButtons) b.addEventListener('click', () => void load(fundusFromUrl(b.dataset.sample ?? ''), b));
    const upload = $<HTMLInputElement>('[data-upload]');
    upload.addEventListener('change', () => {
      const file = upload.files?.[0];
      if (file) void load(fundusFromFile(file), uploadLabel);
    });

    // Drop a photo on the image.
    const drop = $<HTMLElement>('[data-drop]');
    drop.addEventListener('dragover', (e) => {
      e.preventDefault();
      drop.classList.add('is-over');
    });
    drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      drop.classList.remove('is-over');
      const file = e.dataTransfer?.files[0];
      if (file) void load(fundusFromFile(file), uploadLabel);
    });

    for (const input of Object.values(inputs)) input.addEventListener('input', update);
    $<HTMLButtonElement>('[data-reset]').addEventListener('click', () => {
      resetSliders();
      update();
    });

    // Start with the clear example photo.
    const first = sourceButtons[0];
    if (first) void load(fundusFromUrl(first.dataset.sample ?? ''), first);
  }
</script>

<style>
  .block {
    margin-top: var(--space-6);
  }

  .block-sm {
    margin-top: var(--space-3);
  }

  /* Source text starts lowercase (CONTENT.md); capitalize visually only. */
  .cap::first-letter {
    text-transform: uppercase;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
  }

  .figures {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    margin-top: var(--space-3);
  }

  .figures li {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 480px) {
    .figures li {
      display: grid;
      grid-template-columns: 8.5rem 1fr;
      align-items: baseline;
      gap: var(--space-4);
    }
  }

  .figures__value {
    font-size: var(--step-1);
  }

  .figures__label {
    color: var(--text-dim);
  }

  .gate {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-7);
  }

  @media (min-width: 960px) {
    .gate {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }

  .gate__drop {
    position: relative;
    max-width: 400px;
    outline: 1px dashed transparent;
    outline-offset: 6px;
    transition: outline-color 150ms ease;
  }

  .gate__drop:global(.is-over) {
    outline-color: var(--text);
  }

  .gate__drop-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1.9em;
    text-align: start;
    color: var(--text-dim);
    font-size: var(--step--1);
  }

  .gate__eye {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    background: #000;
  }

  .gate__fp {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    max-width: 400px;
    margin-top: var(--space-7);
  }

  .gate__warn {
    max-width: 400px;
    margin-top: var(--space-3);
    color: var(--text);
  }

  .gate__upload {
    cursor: pointer;
  }

  .gate__upload:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .gate__upload[data-active] {
    border-color: var(--text);
    background: var(--surface);
  }

  .gate__private {
    margin-top: var(--space-3);
  }

  .gate__sliders {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  @media (min-width: 640px) {
    .gate__sliders {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .gate__sliders .field {
    margin-top: 0;
  }

  .gate__reset {
    margin-top: var(--space-2);
    padding: 0;
    min-height: 32px;
    background: none;
    border: 0;
    color: var(--accent);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .gate__table {
    width: 100%;
    border-collapse: collapse;
    margin-top: var(--space-5);
  }

  .gate__table th,
  .gate__table td {
    text-align: start;
    padding-block: var(--space-3);
    padding-inline: 0 var(--space-3);
    border-bottom: 1px solid var(--border);
    font-weight: 400;
  }

  .gate__table thead th {
    color: var(--text-dim);
    font-size: var(--step--1);
  }

  .gate__table tbody th {
    font-weight: 600;
  }

  .gate__table :global(.fail) {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .gate__verdict {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--step-2);
    margin-top: var(--space-5);
  }

  .gate__verdict ~ p {
    margin-top: var(--space-3);
  }
</style>
