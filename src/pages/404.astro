---
import Base from '../layouts/Base.astro';
import { content, langOf, localize } from '../content/i18n';

const lang = langOf(Astro.url);
const L = (path: string): string => localize(path, lang);
const { identity, ui } = content(lang);

/*
 * The 404 eye, drawn as SVG at build time (no WebGL on this page).
 * How it works: the white of the eye is the front half of the same Fibonacci shell the home
 * page uses, flattened onto the page. The iris is a group (fibres, pupil, rim, light dot) that
 * a small script slides around, squashing it as it nears the edge so it reads as turning.
 * It glances at random spots, as if searching for the missing page, and follows the cursor
 * for a moment whenever the mouse moves.
 */
let seed = 404;
const rand = (): number => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};
const R = 100;
const dots: { x: number; y: number }[] = [];
const golden = Math.PI * (3 - Math.sqrt(5));
for (let i = 0; i < 1200; i++) {
  const y = 1 - ((i + 0.5) / 1200) * 2;
  const rr = Math.sqrt(1 - y * y);
  const z = Math.sin(i * golden) * rr;
  if (z < 0) continue;
  dots.push({ x: Math.cos(i * golden) * rr * R, y: y * R });
}
const fibres = Array.from({ length: 150 }, () => {
  const a = rand() * Math.PI * 2;
  const r0 = 15 + rand() * 8;
  const r1 = 28 + rand() * 11;
  return {
    x1: Math.cos(a) * r0,
    y1: Math.sin(a) * r0,
    x2: Math.cos(a) * r1,
    y2: Math.sin(a) * r1,
    light: rand() < 0.62,
    o: (0.15 + rand() * 0.35).toFixed(2),
  };
});
---
<Base title={`${ui.notFound.heading} · ${identity.name}`} description={ui.meta.description} noindex>
  <section class="not-found">
    <div class="container">
      <div class="not-found__grid wide">
        <div>
          <p class="not-found__code" aria-hidden="true">404</p>
          <h1 class="not-found__title">{ui.notFound.heading}</h1>
          <p class="not-found__body dim">{ui.notFound.body}</p>
          <a class="btn btn-primary not-found__home" href={L('/')}>{ui.notFound.home}</a>
        </div>

        <svg class="not-found__eye" viewBox="-110 -110 220 220" aria-hidden="true" data-lost-eye>
          <defs>
            <radialGradient id="iris-base">
              <stop offset="0.35" stop-color="#B4B2AC"></stop>
              <stop offset="0.8" stop-color="#86857F"></stop>
              <stop offset="1" stop-color="#5E5E5B"></stop>
            </radialGradient>
          </defs>
          <circle r={R} style="fill: var(--bg)"></circle>
          <g style="fill: var(--eye-sclera)">
            {dots.map((d) => <rect x={(d.x - 1).toFixed(1)} y={(d.y - 1).toFixed(1)} width="2" height="2"></rect>)}
          </g>
          <g data-iris>
            <circle r="40" fill="url(#iris-base)"></circle>
            {
              fibres.map((f) => (
                <line
                  x1={f.x1.toFixed(1)}
                  y1={f.y1.toFixed(1)}
                  x2={f.x2.toFixed(1)}
                  y2={f.y2.toFixed(1)}
                  stroke={f.light ? '#E2E0DA' : '#1C1D21'}
                  stroke-opacity={f.light ? f.o : (Number(f.o) * 0.45).toFixed(2)}
                  stroke-width="0.9"
                  stroke-linecap="round"
                ></line>
              ))
            }
            <circle r="38.5" fill="none" stroke="#3C3D42" stroke-width="3"></circle>
            <circle r="13.5" fill="#050608" stroke="#E8E6E1" stroke-width="1.4"></circle>
            <circle cx="-11" cy="-12" r="3.2" fill="#FFFFFF"></circle>
          </g>
        </svg>
      </div>
    </div>
  </section>
</Base>

<script>
  const svg = document.querySelector<SVGSVGElement>('[data-lost-eye]');
  const iris = svg?.querySelector<SVGGElement>('[data-iris]');
  if (svg && iris && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const MAX = 52; // how far the iris centre can travel (the eye's radius is 100)
    let x = 0;
    let y = 0;
    let tx = 0;
    let ty = 0;
    let followUntil = 0;
    let nextGlance = 0;

    window.addEventListener('mousemove', (e) => {
      const b = svg.getBoundingClientRect();
      const cx = b.left + b.width / 2;
      const cy = b.top + b.height / 2;
      const dx = e.clientX - cx;
      const dy = e.clientY - cy;
      const d = Math.hypot(dx, dy) || 1;
      const reach = Math.min(1, d / (b.width * 0.9));
      tx = (dx / d) * MAX * reach;
      ty = (dy / d) * MAX * reach;
      followUntil = performance.now() + 2000;
    });

    const frame = (now: number): void => {
      if (now > followUntil && now > nextGlance) {
        // Searching: glance at a random spot, linger, glance again.
        const a = Math.random() * Math.PI * 2;
        const r = MAX * (0.45 + Math.random() * 0.55);
        tx = Math.cos(a) * r;
        ty = Math.sin(a) * r * 0.8;
        nextGlance = now + 700 + Math.random() * 1100;
      }
      x += (tx - x) * 0.12;
      y += (ty - y) * 0.12;
      // Foreshorten along the direction of travel, so the iris reads as turning on a ball.
      const r = Math.hypot(x, y);
      const squash = Math.sqrt(Math.max(0.3, 1 - (r / 100) ** 2));
      const deg = (Math.atan2(y, x) * 180) / Math.PI;
      iris.setAttribute(
        'transform',
        `translate(${x.toFixed(2)} ${y.toFixed(2)}) rotate(${deg.toFixed(1)}) scale(${squash.toFixed(3)} 1) rotate(${(-deg).toFixed(1)})`,
      );
      if (document.visibilityState === 'visible') requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') requestAnimationFrame(frame);
    });
  }
</script>

<style>
  .not-found {
    padding-block: clamp(48px, 10vw, 128px);
  }

  .not-found__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 860px) {
    .not-found__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .not-found__code {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--text-dim);
    font-size: var(--step-1);
  }

  .not-found__title {
    font-size: var(--step-4);
    margin-top: var(--space-3);
  }

  .not-found__body {
    margin-top: var(--space-4);
  }

  .not-found__home {
    margin-top: var(--space-6);
  }

  .not-found__eye {
    width: min(360px, 80vw);
    height: auto;
    justify-self: center;
  }
</style>
