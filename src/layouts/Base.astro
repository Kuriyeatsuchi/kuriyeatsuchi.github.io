---
import '../styles/global.css';
import StarField from '../components/StarField.astro';
import { content, langOf, localize } from '../content/i18n';

const lang = langOf(Astro.url);
const { hcgcc, identity, mizan, projectPages, retina, ui } = content(lang);
const L = (path: string): string => localize(path, lang);

interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL, e.g. "/". Omit for pages that shouldn't be indexed. */
  canonicalPath?: string;
  noindex?: boolean;
  /** The 404 page: GitHub Pages serves one 404.html for every missing address. */
  notFound?: boolean;
}

const { title, description, canonicalPath, noindex = false, notFound = false } = Astro.props;

// Projects menu: each project's page plus its own links (only the ones that exist).
type MenuLink = { label: string; href: string };
const extra: Record<string, (MenuLink | null)[]> = {
  mizan: [
    mizan.liveAppUrl ? { label: ui.mizan.liveApp, href: mizan.liveAppUrl } : null,
    mizan.codeUrl ? { label: ui.mizan.code, href: mizan.codeUrl } : null,
  ],
  retina: [
    { label: ui.retinaGate.heading, href: '/retina#gate' },
    retina.repoUrl ? { label: ui.retina.code, href: retina.repoUrl } : null,
  ],
  hcgcc: [
    hcgcc.deckHref ? { label: ui.hcgcc.openDeck, href: hcgcc.deckHref } : null,
    { label: ui.hcgccBuilder.heading, href: '/hcgcc#build-title' },
  ],
};
const menu = projectPages.map((p) => ({
  ...p,
  links: (extra[p.slug] ?? []).filter((l): l is MenuLink => l !== null),
}));
const other = lang === 'ar' ? 'en' : 'ar';
const abs = (path: string): string | null => (Astro.site ? new URL(path, Astro.site).href : null);
const canonical = canonicalPath ? abs(L(canonicalPath)) : null;
// The same page in the other language (pages without a canonical path, like the 404, have none).
const otherPath = canonicalPath ? localize(canonicalPath, other) : null;
const alternates = canonicalPath
  ? [
      { hreflang: 'en', href: abs(localize(canonicalPath, 'en')) },
      { hreflang: 'ar', href: abs(localize(canonicalPath, 'ar')) },
      { hreflang: 'x-default', href: abs(localize(canonicalPath, 'en')) },
    ]
  : [];
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : null;
const goatcounter = identity.goatcounterCode;
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => a.href && <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {noindex && <meta name="robots" content="noindex" />}
    {
      notFound && lang === 'en' && (
        <script is:inline>
          // A missing Arabic address (/ar/...) gets the Arabic "page not found" instead.
          if (location.pathname === '/ar' || location.pathname.indexOf('/ar/') === 0) location.replace('/ar/404/');
        </script>
      )
    }
    <meta name="theme-color" content="#0B0D12" data-theme-color />
    {/* Light or dark, before first paint so the page never flashes. Dark unless the visitor chose light. */}
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
          document.querySelector('[data-theme-color]').content = '#F4F2ED';
        }
      } catch (e) {}
    </script>
    <link rel="icon" href="/favicon.svg?v=moon" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {/* Link preview: scripts/make_og.py renders public/og.png (1200 x 630). */}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ui.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="preload" href="/fonts/InstrumentSans-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexSans-Regular.woff2" as="font" type="font/woff2" crossorigin />

    {
      goatcounter && (
        <script
          is:inline
          data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <StarField />
    <a class="skip-link" href="#main">{ui.skipLink}</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__logo" href={L('/')} aria-label={lang === 'ar' ? `${identity.name}، ${ui.nav.home}` : `${identity.name}, ${ui.nav.home}`}>
          <svg aria-hidden="true" width="28" height="28" viewBox="0 0 32 32">
            <path d="M13.389 5.315A11 11 0 1 0 26.685 18.611A9.5 9.5 0 0 1 13.389 5.315Z" fill="currentColor"></path>
          </svg>
        </a>
        <nav aria-label={ui.nav.main}>
          <ul class="site-nav">
            <li class="nav-projects" data-menu>
              <a href={L('/#projects')} aria-haspopup="true" aria-expanded="false" aria-controls="projects-menu" data-menu-trigger>
                {ui.nav.projects}
                <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 3.5 5 6.5 8 3.5"></path></svg>
              </a>
              <div class="projects-menu" id="projects-menu" data-menu-panel>
                <ul class="projects-menu__grid">
                  {
                    menu.map((p) => (
                      <li class="projects-menu__item">
                        <a class="projects-menu__title" href={L(`/${p.slug}`)}>{p.title}</a>
                        <p class="projects-menu__meta">{p.meta}</p>
                        <ul class="projects-menu__links">
                          {p.links.map((l) => (
                            <li>
                              <a href={L(l.href)}>{l.label}</a>
                            </li>
                          ))}
                        </ul>
                      </li>
                    ))
                  }
                </ul>
                <a class="projects-menu__all" href={L('/#projects')}>{ui.pages.allProjects}</a>
              </div>
            </li>
            <li><a href={L('/#achievements')}>{ui.nav.achievements}</a></li>
            <li><a href={L('/library')}>{ui.nav.library}</a></li>
            <li><a href={L('/#contact')}>{ui.nav.contact}</a></li>
            {
              otherPath && (
                <li>
                  <a class="lang-switch" href={otherPath} lang={other} hreflang={other} aria-label={ui.nav.otherLanguageLabel}>
                    {ui.nav.otherLanguage}
                  </a>
                </li>
              )
            }
            <li>
              <button class="theme-toggle" type="button" data-theme-toggle aria-label={ui.nav.toLight}
                data-to-light={ui.nav.toLight} data-to-dark={ui.nav.toDark}>
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18">
                  <circle cx="9" cy="9" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
                  <path d="M9 1.75a7.25 7.25 0 0 1 0 14.5Z" fill="currentColor"></path>
                </svg>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>{ui.footer}</p>
      </div>
    </footer>
  </body>
</html>

<script>
  // Light/dark switch: flips the page, remembers the choice, and tells the starfield and the
  // 3D scene (a "themechange" event) so they recolour.
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (toggle) {
    const root = document.documentElement;
    const label = (): void => {
      const light = root.dataset.theme === 'light';
      toggle.setAttribute('aria-label', (light ? toggle.dataset.toDark : toggle.dataset.toLight) ?? '');
      toggle.setAttribute('aria-pressed', light ? 'true' : 'false');
    };
    label();
    toggle.addEventListener('click', () => {
      const light = root.dataset.theme !== 'light';
      if (light) root.dataset.theme = 'light';
      else delete root.dataset.theme;
      try {
        localStorage.setItem('theme', light ? 'light' : 'dark');
      } catch {
        /* private browsing: the choice lasts for this page only */
      }
      document.querySelector<HTMLMetaElement>('[data-theme-color]')?.setAttribute('content', light ? '#F4F2ED' : '#0B0D12');
      label();
      document.dispatchEvent(new Event('themechange'));
    });
  }

  // Projects menu: opens on hover (with a short close delay), on keyboard focus, and on
  // tap for touch screens (the first tap opens it, the second follows the link). Esc closes.
  const item = document.querySelector<HTMLElement>('[data-menu]');
  const trigger = item?.querySelector<HTMLAnchorElement>('[data-menu-trigger]');
  if (item && trigger) {
    let timer = 0;
    const set = (open: boolean): void => {
      item.toggleAttribute('data-open', open);
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    const isOpen = (): boolean => item.hasAttribute('data-open');
    item.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      clearTimeout(timer);
      set(true);
    });
    item.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      timer = window.setTimeout(() => set(false), 180);
    });
    item.addEventListener('focusin', () => set(true));
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node | null)) set(false);
    });
    trigger.addEventListener('click', (e) => {
      if (window.matchMedia('(hover: none)').matches && !isOpen()) {
        e.preventDefault();
        set(true);
      }
    });
    document.addEventListener('pointerdown', (e) => {
      if (isOpen() && !item.contains(e.target as Node)) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        set(false);
        trigger.focus();
      }
    });
  }
</script>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-4);
    top: var(--space-4);
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    border-radius: var(--radius);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-5);
  }

  /* The moon: same mark as the favicon. */
  .site-header__logo {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-inline-start: -8px;
    color: var(--text);
    transition: transform 400ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .site-header__logo:hover {
    transform: rotate(-18deg);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    font-size: var(--step--1);
  }

  .site-nav a {
    color: var(--text-dim);
    text-decoration: none;
    display: inline-block;
    padding-block: var(--space-2);
  }

  .site-nav a:hover {
    color: var(--text);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-block: -4px;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--text-dim);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--text);
  }

  .theme-toggle svg {
    transition: transform 400ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  :root[data-theme='light'] .theme-toggle svg {
    transform: rotate(180deg);
  }

  /* ---------- Projects menu ---------- */
  .nav-projects {
    position: relative;
  }

  .nav-projects > a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .nav-projects > a svg {
    transition: transform 200ms ease;
  }

  .nav-projects[data-open] > a {
    color: var(--text);
  }

  .nav-projects[data-open] > a svg {
    transform: rotate(180deg);
  }

  .projects-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    width: min(760px, calc(100vw - 2 * var(--gutter)));
    padding-top: var(--space-3); /* a bridge, so moving down to the menu keeps it open */
    transform: translate(-50%, -6px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 160ms ease, transform 200ms ease, visibility 0s linear 200ms;
  }

  @media (max-width: 760px) {
    .projects-menu {
      position: fixed;
      top: 64px;
      left: var(--gutter);
      right: var(--gutter);
      width: auto;
      transform: translateY(-6px);
    }
  }

  .nav-projects[data-open] .projects-menu {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition: opacity 160ms ease, transform 200ms ease, visibility 0s;
  }

  @media (max-width: 760px) {
    .nav-projects[data-open] .projects-menu {
      transform: none;
    }
  }

  .projects-menu__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    list-style: none;
    padding: var(--space-5);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: 0 24px 60px var(--shadow);
  }

  @media (max-width: 760px) {
    .projects-menu__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .projects-menu__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .site-nav .projects-menu__title {
    padding: 0;
    color: var(--text);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--step-0);
    line-height: 1.3;
  }

  .site-nav .projects-menu__title:hover {
    color: var(--accent);
  }

  .projects-menu__meta {
    color: var(--text-dim);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .projects-menu__links {
    list-style: none;
    margin-top: var(--space-2);
    display: grid;
    gap: var(--space-1);
  }

  .site-nav .projects-menu__links a,
  .site-nav .projects-menu__all {
    padding: 0;
    color: var(--accent);
    font-weight: 600;
  }

  .site-nav .projects-menu__links a:hover,
  .site-nav .projects-menu__all:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-nav .projects-menu__all {
    display: inline-block;
    margin: var(--space-3) 0 0;
    margin-inline-start: var(--space-2);
    font-size: var(--step--1);
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-menu,
    .nav-projects[data-open] .projects-menu {
      transition: none;
    }
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: var(--space-6);
    color: var(--text-dim);
    font-size: var(--step--1);
  }
</style>
