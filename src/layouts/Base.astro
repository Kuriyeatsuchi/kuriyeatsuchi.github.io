---
import '../styles/global.css';
import StarField from '../components/StarField.astro';
import { content, langOf, localize } from '../content/i18n';

const lang = langOf(Astro.url);
const { hcgcc, identity, mizan, projectPages, retina, ui } = content(lang);
const L = (path: string): string => localize(path, lang);

interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL, e.g. "/". Omit for pages that shouldn't be indexed. */
  canonicalPath?: string;
  noindex?: boolean;
  /** The 404 page: GitHub Pages serves one 404.html for every missing address. */
  notFound?: boolean;
}

const { title, description, canonicalPath, noindex = false, notFound = false } = Astro.props;

// Projects menu: each project's page plus its own links (only the ones that exist).
type MenuLink = { label: string; href: string };
const extra: Record<string, (MenuLink | null)[]> = {
  mizan: [
    mizan.liveAppUrl ? { label: ui.mizan.liveApp, href: mizan.liveAppUrl } : null,
    mizan.codeUrl ? { label: ui.mizan.code, href: mizan.codeUrl } : null,
  ],
  retina: [
    { label: ui.retinaGate.heading, href: '/retina#gate' },
    retina.repoUrl ? { label: ui.retina.code, href: retina.repoUrl } : null,
  ],
  hcgcc: [
    hcgcc.deckHref ? { label: ui.hcgcc.openDeck, href: hcgcc.deckHref } : null,
    { label: ui.hcgccBuilder.heading, href: '/hcgcc#build-title' },
  ],
};
// In the menu every project's line must fit on one line on a phone, so HCGCC uses its short name.
const menu = projectPages.map((p) => ({
  ...p,
  meta: p.slug === 'hcgcc' ? `${hcgcc.competitionShort} · ${hcgcc.result}` : p.meta,
  links: (extra[p.slug] ?? []).filter((l): l is MenuLink => l !== null),
}));
const other = lang === 'ar' ? 'en' : 'ar';
const abs = (path: string): string | null => (Astro.site ? new URL(path, Astro.site).href : null);
const canonical = canonicalPath ? abs(L(canonicalPath)) : null;
// The same page in the other language (pages without a canonical path, like the 404, have none).
const otherPath = canonicalPath ? localize(canonicalPath, other) : notFound ? (other === 'ar' ? '/ar/404/' : '/404') : null;
const alternates = canonicalPath
  ? [
      { hreflang: 'en', href: abs(localize(canonicalPath, 'en')) },
      { hreflang: 'ar', href: abs(localize(canonicalPath, 'ar')) },
      { hreflang: 'x-default', href: abs(localize(canonicalPath, 'en')) },
    ]
  : [];
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : null;
const goatcounter = identity.goatcounterCode;
// Themes in the moon menu; the current design stays first. Swatch colours only.
const themes = [
  { key: 'default', bg: '#0B0D12', accent: '#F08A4B' },
  { key: 'frost', bg: '#0B0D12', accent: '#38BDF8' },
] as const;
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => a.href && <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {noindex && <meta name="robots" content="noindex" />}
    {
      notFound && lang === 'en' && (
        <script is:inline>
          // A missing Arabic address (/ar/... or one with Arabic letters) gets the Arabic "page not found".
          (function () {
            var p = location.pathname;
            try { p = decodeURIComponent(p); } catch (e) {}
            if (p === '/ar' || p.indexOf('/ar/') === 0 || /[\u0600-\u06FF]/.test(p)) location.replace('/ar/404/');
          })();
        </script>
      )
    }
    <meta name="theme-color" content="#0B0D12" data-theme-color />
    {/* Light or dark, before first paint so the page never flashes. Dark unless the visitor chose light. */}
    <script is:inline>
      // Light/dark (every device) and theme (computers only for now: phones have no theme menu
      // yet), before first paint so the page never flashes. Dark and Default unless chosen.
      try {
        var r = document.documentElement;
        var mode = localStorage.getItem('mode');
        var theme = localStorage.getItem('theme');
        if (theme === 'light') { mode = 'light'; theme = 'default'; } // older saved choice
        if (mode === 'light') r.dataset.mode = 'light';
        if (theme === 'frost' && matchMedia('(hover: hover) and (pointer: fine)').matches) r.dataset.theme = 'frost';
        var light = r.dataset.mode === 'light';
        document.querySelector('[data-theme-color]').content = light ? (r.dataset.theme === 'frost' ? '#F3F6F9' : '#F4F2ED') : '#0B0D12';
      } catch (e) {}
    </script>
    <link rel="icon" href="/favicon.ico?v=moon" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=moon" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=moon" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {/* Link preview: scripts/make_og.py renders public/og.png (1200 x 630). */}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ui.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="preload" href="/fonts/InstrumentSans-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexSans-Regular.woff2" as="font" type="font/woff2" crossorigin />

    {
      goatcounter && (
        <script
          is:inline
          data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <StarField />
    <a class="skip-link" href="#main">{ui.skipLink}</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <div class="theme-menu" data-theme-menu>
          <a class="site-header__logo" aria-haspopup="true" aria-expanded="false" aria-controls="theme-menu" data-theme-trigger href={L('/')} aria-label={lang === 'ar' ? `${identity.name}، ${ui.nav.home}` : `${identity.name}, ${ui.nav.home}`}>
            <svg aria-hidden="true" width="28" height="28" viewBox="0 0 32 32">
              <path d="M13.389 5.315A11 11 0 1 0 26.685 18.611A9.5 9.5 0 0 1 13.389 5.315Z" fill="currentColor"></path>
            </svg>
          </a>
          {/* Computers: hover (or keyboard focus) on the moon opens the theme list; clicking it still goes home. */}
          <div class="theme-menu__panel" id="theme-menu" data-theme-panel>
            <div class="theme-menu__box">
              <p class="theme-menu__label">{ui.nav.themes}</p>
              <ul class="theme-menu__list">
                {
                  themes.map((t) => (
                    <li>
                      <button type="button" class="theme-menu__choice" data-theme-choice={t.key} aria-pressed="false">
                        <span class="theme-menu__swatch" style={`--sw-bg:${t.bg};--sw-accent:${t.accent}`} aria-hidden="true"></span>
                        {ui.nav.themeNames[t.key]}
                      </button>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
        <nav aria-label={ui.nav.main}>
          <ul class="site-nav">
            <li class="nav-projects" data-menu>
              <a href={L('/#projects')} aria-haspopup="true" aria-expanded="false" aria-controls="projects-menu" data-menu-trigger>
                {ui.nav.projects}
                <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 3.5 5 6.5 8 3.5"></path></svg>
              </a>
              <div class="projects-menu" id="projects-menu" data-menu-panel>
                <div class="projects-menu__box">
                <ul class="projects-menu__grid">
                  {
                    menu.map((p) => (
                      <li class="projects-menu__item">
                        <a class="projects-menu__title" href={L(`/${p.slug}`)}>{p.title}</a>
                        <p class="projects-menu__meta">{p.meta}</p>
                        <ul class="projects-menu__links">
                          {p.links.map((l) => (
                            <li>
                              <a href={L(l.href)}>{l.label}</a>
                            </li>
                          ))}
                        </ul>
                      </li>
                    ))
                  }
                </ul>
                <a class="projects-menu__all" href={L('/#projects')}>{ui.pages.allProjects}</a>
                </div>
              </div>
            </li>
            <li><a href={L('/#achievements')}>{ui.nav.achievements}</a></li>
            <li><a href={L('/library')}>{ui.nav.library}</a></li>
            <li><a href={L('/#contact')}>{ui.nav.contact}</a></li>
          </ul>
        </nav>
        <div class="site-header__tools">
          {
            otherPath && (
              <a class="lang-switch" href={otherPath} lang={other} hreflang={other} aria-label={ui.nav.otherLanguageLabel}>
                {ui.nav.otherLanguage}
              </a>
            )
          }
          <button class="theme-toggle" type="button" data-mode-toggle aria-label={ui.nav.toLight}
            data-to-light={ui.nav.toLight} data-to-dark={ui.nav.toDark}>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18">
              <circle cx="9" cy="9" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
              <path d="M9 1.75a7.25 7.25 0 0 1 0 14.5Z" fill="currentColor"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>{ui.footer}</p>
      </div>
    </footer>
  </body>
</html>

<script>
  // The browser bar colour follows the page background.
  const syncMetaColor = (): void => {
    const r = document.documentElement;
    const light = r.dataset.mode === 'light';
    const color = light ? (r.dataset.theme === 'frost' ? '#F3F6F9' : '#F4F2ED') : '#0B0D12';
    document.querySelector<HTMLMetaElement>('[data-theme-color]')?.setAttribute('content', color);
  };

  // Light/dark switch (every device, any theme): flips the page, remembers the choice, and tells
  // the starfield and the 3D scene (a "themechange" event) so they recolour.
  const modeToggle = document.querySelector<HTMLButtonElement>('[data-mode-toggle]');
  if (modeToggle) {
    const root = document.documentElement;
    const label = (): void => {
      const light = root.dataset.mode === 'light';
      modeToggle.setAttribute('aria-label', (light ? modeToggle.dataset.toDark : modeToggle.dataset.toLight) ?? '');
      modeToggle.setAttribute('aria-pressed', light ? 'true' : 'false');
    };
    label();
    modeToggle.addEventListener('click', () => {
      const light = root.dataset.mode !== 'light';
      if (light) root.dataset.mode = 'light';
      else delete root.dataset.mode;
      try {
        localStorage.setItem('mode', light ? 'light' : 'dark');
      } catch {
        /* private browsing: the choice lasts for this page only */
      }
      syncMetaColor();
      label();
      document.dispatchEvent(new Event('themechange'));
    });
  }

  // Theme menu (computers): hover on the moon for a moment, or focus it with the keyboard, and
  // the list opens with a small wiggle of the moon. Picking a theme recolours the page (in
  // light or dark), is remembered, and tells the starfield and the 3D scene (a "themechange" event).
  const themeMenu = document.querySelector<HTMLElement>('[data-theme-menu]');
  const themeTrigger = themeMenu?.querySelector<HTMLAnchorElement>('[data-theme-trigger]');
  if (themeMenu && themeTrigger) {
    const root = document.documentElement;
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const choices = Array.from(themeMenu.querySelectorAll<HTMLButtonElement>('[data-theme-choice]'));
    const current = (): string => root.dataset.theme ?? 'default';
    const mark = (): void => {
      for (const c of choices) c.setAttribute('aria-pressed', c.dataset.themeChoice === current() ? 'true' : 'false');
    };
    const apply = (key: string): void => {
      if (key === 'default') delete root.dataset.theme;
      else root.dataset.theme = key;
      try {
        localStorage.setItem('theme', key);
      } catch {
        /* private browsing: the choice lasts for this page only */
      }
      syncMetaColor();
      mark();
      document.dispatchEvent(new Event('themechange'));
    };
    mark();
    let openTimer = 0;
    let closeTimer = 0;
    const isOpen = (): boolean => themeMenu.hasAttribute('data-open');
    const set = (open: boolean): void => {
      if (open === isOpen()) return;
      themeMenu.toggleAttribute('data-open', open);
      themeTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open && !still.matches) {
        themeTrigger.classList.remove('is-wiggling');
        void themeTrigger.offsetWidth; // restart the animation
        themeTrigger.classList.add('is-wiggling');
      }
    };
    themeMenu.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || !canHover.matches) return;
      clearTimeout(closeTimer);
      openTimer = window.setTimeout(() => set(true), 250); // a pause, so passing over doesn't open it
    });
    themeMenu.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      clearTimeout(openTimer);
      closeTimer = window.setTimeout(() => set(false), 200);
    });
    themeMenu.addEventListener('focusin', () => {
      if (canHover.matches) set(true);
    });
    themeMenu.addEventListener('focusout', (e) => {
      if (!themeMenu.contains(e.relatedTarget as Node | null)) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        set(false);
        themeTrigger.focus();
      }
    });
    for (const c of choices) c.addEventListener('click', () => apply(c.dataset.themeChoice ?? 'default'));
  }

  // Projects menu: opens on hover (with a short close delay), on keyboard focus, and on
  // tap for touch screens (the first tap opens it, the second follows the link). Esc closes.
  const item = document.querySelector<HTMLElement>('[data-menu]');
  const trigger = item?.querySelector<HTMLAnchorElement>('[data-menu-trigger]');
  if (item && trigger) {
    let timer = 0;
    const header = document.querySelector<HTMLElement>('.site-header');
    const set = (open: boolean): void => {
      if (open && header) {
        const bottom = Math.max(8, header.getBoundingClientRect().bottom);
        document.documentElement.style.setProperty('--menu-top', `${Math.round(bottom)}px`);
      }
      item.toggleAttribute('data-open', open);
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    const isOpen = (): boolean => item.hasAttribute('data-open');
    item.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      clearTimeout(timer);
      set(true);
    });
    item.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      timer = window.setTimeout(() => set(false), 180);
    });
    item.addEventListener('focusin', () => set(true));
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node | null)) set(false);
    });
    trigger.addEventListener('click', (e) => {
      if (window.matchMedia('(hover: none)').matches && !isOpen()) {
        e.preventDefault();
        set(true);
      }
    });
    document.addEventListener('pointerdown', (e) => {
      if (isOpen() && !item.contains(e.target as Node)) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        set(false);
        trigger.focus();
      }
    });
  }
</script>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-4);
    top: var(--space-4);
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    border-radius: var(--radius);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-5);
  }

  /* The moon: same mark as the favicon. */
  .site-header__logo {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-inline-start: -8px;
    color: var(--text);
  }

  /* The moon wiggles once when the theme list opens. */
  .site-header__logo:global(.is-wiggling) svg {
    animation: moon-wiggle 480ms ease-in-out;
  }

  @keyframes moon-wiggle {
    0% {
      transform: rotate(0);
    }
    30% {
      transform: rotate(-16deg);
    }
    60% {
      transform: rotate(9deg);
    }
    85% {
      transform: rotate(-3deg);
    }
    100% {
      transform: rotate(0);
    }
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-block: -4px;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--text-dim);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--text);
  }

  .theme-toggle svg {
    transition: transform 400ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  :root[data-mode='light'] .theme-toggle svg {
    transform: rotate(180deg);
  }

  /* ---------- Theme menu (computers only for now) ---------- */
  .theme-menu {
    position: relative;
  }

  .theme-menu__panel {
    position: absolute;
    top: 100%;
    inset-inline-start: -8px;
    z-index: 11;
    min-width: 200px;
    padding-top: var(--space-2); /* a bridge, so moving down keeps it open */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 160ms ease, transform 200ms ease, visibility 0s linear 200ms;
  }

  .theme-menu[data-open] .theme-menu__panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 160ms ease, transform 200ms ease, visibility 0s;
  }

  @media (hover: none), (pointer: coarse) {
    .theme-menu__panel {
      display: none;
    }
  }

  .theme-menu__box {
    padding: var(--space-3);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: 0 24px 60px var(--shadow);
  }

  .theme-menu__label {
    padding: var(--space-1) var(--space-2) var(--space-2);
    color: var(--text-dim);
    font-size: 0.8125rem;
  }

  .theme-menu__list {
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .theme-menu__choice {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: 40px;
    padding: 0 var(--space-2);
    background: none;
    border: 0;
    border-radius: var(--radius);
    color: var(--text-dim);
    font: inherit;
    font-size: var(--step--1);
    text-align: start;
    cursor: pointer;
  }

  .theme-menu__choice:hover,
  .theme-menu__choice[aria-pressed='true'] {
    background: var(--surface);
    color: var(--text);
  }

  /* A small preview of each theme: its background with its accent. */
  .theme-menu__swatch {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--sw-bg);
    border: 1px solid var(--border-strong);
  }

  .theme-menu__swatch::after {
    content: '';
    position: absolute;
    inset: 5px;
    border-radius: 50%;
    background: var(--sw-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-menu__panel,
    .theme-menu[data-open] .theme-menu__panel {
      transition: none;
    }
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-5);
    list-style: none;
    font-size: var(--step--1);
  }

  /* Phones: the menu wraps onto two lines instead of pushing the page wider than the screen. */
  @media (max-width: 560px) {
    .site-nav {
      gap: 0 var(--space-4);
    }
  }

  .site-nav a {
    color: var(--text-dim);
    text-decoration: none;
    display: inline-block;
    padding-block: var(--space-2);
  }

  .site-nav a:hover {
    color: var(--text);
  }

  /* Menu, then the language and light/dark switches. On phones the switches sit on the
     logo's row and the menu gets a full row of its own. */
  .site-header nav {
    margin-inline-start: auto;
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .lang-switch {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--text-dim);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .lang-switch:hover {
    color: var(--text);
  }

  @media (max-width: 760px) {
    .site-header__tools {
      order: 1;
      margin-inline-start: auto;
    }

    .site-header nav {
      order: 2;
      flex-basis: 100%;
      margin-inline-start: 0;
    }
  }

  /* ---------- Projects menu ---------- */
  .nav-projects {
    position: relative;
  }

  .nav-projects > a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .nav-projects > a svg {
    transition: transform 200ms ease;
  }

  .nav-projects[data-open] > a {
    color: var(--text);
  }

  .nav-projects[data-open] > a svg {
    transform: rotate(180deg);
  }

  .projects-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    width: min(760px, calc(100vw - 2 * var(--gutter)));
    padding-top: var(--space-3); /* a bridge, so moving down to the menu keeps it open */
    transform: translate(-50%, -6px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 160ms ease, transform 200ms ease, visibility 0s linear 200ms;
  }

  @media (max-width: 760px) {
    .projects-menu {
      position: fixed;
      top: var(--menu-top, 64px);
      left: var(--gutter);
      right: var(--gutter);
      width: auto;
      transform: translateY(-6px);
    }
  }

  .nav-projects[data-open] .projects-menu {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition: opacity 160ms ease, transform 200ms ease, visibility 0s;
  }

  @media (max-width: 760px) {
    .nav-projects[data-open] .projects-menu {
      transform: none;
    }
  }

